<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Dashboard View
        ==============
        MERN equivalent: Dashboard page with summary cards + charts
        Odoo uses: graph view / pivot view / cohort view for dashboards
    -->

    <!-- Student Stats — Graph (bar chart) by class -->
    <record id="view_student_dashboard_graph" model="ir.ui.view">
        <field name="name">school.student.dashboard.graph</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <graph string="Students by Class" type="bar" stacked="1">
                <field name="class_id" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Student Stats — Pivot table -->
    <record id="view_student_dashboard_pivot" model="ir.ui.view">
        <field name="name">school.student.dashboard.pivot</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <pivot string="Student Stats">
                <field name="class_id" type="row"/>
                <field name="state" type="col"/>
                <field name="attendance_percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Attendance Stats — Graph (pie chart by status) -->
    <record id="view_attendance_dashboard_graph" model="ir.ui.view">
        <field name="name">school.attendance.dashboard.graph</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance Overview" type="pie">
                <field name="status" type="row"/>
            </graph>
        </field>
    </record>

    <!-- Fee Stats — Graph -->
    <record id="view_fee_dashboard_graph" model="ir.ui.view">
        <field name="name">school.fee.dashboard.graph</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <graph string="Fee Collection" type="bar">
                <field name="fee_type" type="row"/>
                <field name="state" type="col"/>
                <field name="final_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!--
        Dashboard Action using act_window with multiple views
        This renders as a proper dashboard page in Odoo
    -->
    <record id="action_school_dashboard" model="ir.actions.act_window">
        <field name="name">📊 School Dashboard</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="view_id" ref="view_student_dashboard_graph"/>
        <field name="context">{
            'search_default_filter_confirmed': 1,
            'graph_measure': '__count__'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                📊 No data to display yet!
            </p>
            <p>Add students, classes, and mark attendance to see the dashboard populate.</p>
        </field>
    </record>

</odoo>
