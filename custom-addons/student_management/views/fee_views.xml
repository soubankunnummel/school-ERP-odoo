<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_fee_tree" model="ir.ui.view">
        <field name="name">school.fee.tree</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <tree string="Fees"
                  decoration-danger="state == 'overdue'"
                  decoration-success="state == 'paid'"
                  decoration-warning="state == 'partial'"
                  decoration-muted="state == 'waived'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id" optional="show"/>
                <field name="fee_type"/>
                <field name="amount"/>
                <field name="discount_percent" string="Disc %"/>
                <field name="final_amount" string="Net Amount"/>
                <field name="balance" string="Due"/>
                <field name="due_date"/>
                <field name="is_overdue" optional="show" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'overdue'"
                       decoration-success="state == 'paid'"
                       decoration-warning="state in ('pending','partial')"
                       decoration-muted="state == 'waived'"/>
                <button name="action_mark_paid" type="object"
                        string="Mark Paid" icon="fa-check"
                        invisible="state in ('paid', 'waived')"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_fee_form" model="ir.ui.view">
        <field name="name">school.fee.form</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <form string="Fee Record">
                <header>
                    <button name="action_mark_paid" string="✅ Mark as Paid"
                            type="object" class="btn-success"
                            invisible="state in ('paid', 'waived')"/>
                    <button name="action_waive" string="🙅 Waive Fee"
                            type="object"
                            invisible="state == 'waived'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div invisible="is_overdue == False">
                        <span class="badge badge-danger">⚠️ OVERDUE</span>
                    </div>

                    <group>
                        <group string="Student">
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="class_id" readonly="1"/>
                            <field name="fee_type"/>
                        </group>
                        <group string="Amount">
                            <field name="amount"/>
                            <field name="discount_percent" readonly="1"/>
                            <field name="discount_amount" readonly="1"/>
                            <field name="final_amount" readonly="1"/>
                            <field name="paid_amount"/>
                            <field name="balance" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="due_date"/>
                            <field name="paid_date"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                        <group string="Notes">
                            <field name="note" widget="text" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_fee_search" model="ir.ui.view">
        <field name="name">school.fee.search</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <search string="Search Fees">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_type"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state','=','pending')]"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('state','=','overdue')]"/>
                <filter string="Paid" name="filter_paid"
                        domain="[('state','=','paid')]"/>
                <filter string="Has Discount" name="filter_discount"
                        domain="[('discount_percent','>',0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Fee Type" name="group_type"
                            context="{'group_by': 'fee_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Class" name="group_class"
                            context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_fee_graph" model="ir.ui.view">
        <field name="name">school.fee.graph</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <graph string="Fee Statistics" type="bar">
                <field name="fee_type" type="row"/>
                <field name="final_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_school_fee" model="ir.actions.act_window">
        <field name="name">Fees</field>
        <field name="res_model">school.fee</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="search_view_id" ref="view_fee_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fee records yet!</p>
        </field>
    </record>

</odoo>
