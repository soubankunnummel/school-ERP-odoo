<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_subject_tree" model="ir.ui.view">
        <field name="name">school.subject.tree</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <tree string="Subjects">
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <field name="credit_hours"/>
                <field name="is_elective" widget="boolean_toggle"/>
                <field name="student_count" string="Enrolled Students"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">school.subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_title">
                        <label for="code" class="oe_edit_only"/>
                        <h2><field name="code" placeholder="Subject Code"/></h2>
                        <h1><field name="name" placeholder="Subject Name"/></h1>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users" type="object"
                                name="action_view_enrolled_students">
                            <field name="student_count" widget="statinfo"
                                   string="Students"/>
                        </button>
                    </div>

                    <group>
                        <group string="Subject Details">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="credit_hours"/>
                            <field name="is_elective"/>
                        </group>
                        <group string="Assignment">
                            <!-- Many2one: subject taught by one teacher -->
                            <field name="teacher_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1" widget="text"/>
                    </group>

                    <notebook>
                        <!-- Many2many back-relation: students enrolled -->
                        <page string="👨‍🎓 Enrolled Students" name="students">
                            <field name="student_ids" readonly="1">
                                <tree>
                                    <field name="roll_number"/>
                                    <field name="name"/>
                                    <field name="class_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_subject_search" model="ir.ui.view">
        <field name="name">school.subject.search</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <filter string="Elective" name="filter_elective"
                        domain="[('is_elective','=',True)]"/>
                <filter string="Core" name="filter_core"
                        domain="[('is_elective','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Teacher" name="group_teacher"
                            context="{'group_by': 'teacher_id'}"/>
                    <filter string="Elective/Core" name="group_elective"
                            context="{'group_by': 'is_elective'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_school_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_subject_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No subjects yet!</p>
        </field>
    </record>

</odoo>
